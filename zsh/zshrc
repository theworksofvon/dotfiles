# >>> claude account switcher >>>
# Claude derives its Keychain service name from the config dir: unset it and the
# entry is "Claude Code-credentials", set it and an 8-char sha256 of the path is
# appended. So a CLAUDE_CONFIG_DIR per account isolates credentials, history and
# settings on its own — no setup-token needed, and two accounts can run at once.
#
# The corollary is that the default login is only reachable with the variable
# unset: pointing it at ~/.claude hashes to a key that was never written and
# reports "not logged in". That's why the work account below is the bare dir
# rather than a named one — it keeps the existing login and its project history.
CLAUDE_ACCOUNTS_DIR="$HOME/.claude-accounts"

# Log in once per account before first use:
#   claude auth login                                        # work (default dir)
#   CLAUDE_CONFIG_DIR=~/.claude-accounts/<name> claude auth login
claude-account-run() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "usage: claude-account-run <name> [claude args...]"
    echo "accounts: $(claude-account-list | tr '\n' ' ')"
    return 1
  fi
  shift
  local dir="$CLAUDE_ACCOUNTS_DIR/$name"
  _claude_account_seed "$dir" || return 1
  if ! CLAUDE_CONFIG_DIR="$dir" command claude auth status 2>/dev/null | grep -q '"loggedIn": *true'; then
    echo "'$name' isn't logged in yet. Run:"
    echo "  CLAUDE_CONFIG_DIR=$dir claude auth login"
    return 1
  fi
  CLAUDE_CONFIG_DIR="$dir" CLAUDE_ACCOUNT_LABEL="$name" command claude "$@"
}

# Reads the config dirs rather than the Keychain — `security dump-keychain`
# raises an authorization dialog per item.
claude-account-list() {
  local names
  # (N) so an empty accounts dir yields nothing instead of a "no matches" error.
  names=("$CLAUDE_ACCOUNTS_DIR"/*(N/:t))
  if (( ${#names} == 0 )); then
    echo "No accounts yet. Create one with: claude-account-add <name>"
    return 0
  fi
  print -l $names
}

# Seeds the dir and hands off to Claude's own browser login.
claude-account-add() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "usage: claude-account-add <name>"
    return 1
  fi
  _claude_account_seed "$CLAUDE_ACCOUNTS_DIR/$name" || return 1
  CLAUDE_CONFIG_DIR="$CLAUDE_ACCOUNTS_DIR/$name" command claude auth login || return 1
  echo "Ready. Launch it with: claude-account-run $name"
}

# Which account is a given dir logged into? No argument = the default dir.
claude-whoami() {
  local dir="${1:+$CLAUDE_ACCOUNTS_DIR/$1}"
  if [[ -n "$dir" ]]; then
    CLAUDE_CONFIG_DIR="$dir" command claude auth status
  else
    command claude auth status
  fi
}

# Work keeps the default config dir, so it must run with CLAUDE_CONFIG_DIR unset.
claude-cm()       { command claude "$@" }
claude-personal() { claude-account-run personal "$@" }

# A per-account CLAUDE_CONFIG_DIR starts empty, so the dotfiles-managed rules
# and settings need the same links install.sh puts in ~/.claude.
_claude_account_seed() {
  local dir="$1"
  mkdir -p "$dir" || return 1
  [[ -e "$dir/CLAUDE.md" ]]     || ln -s "$HOME/.dotfiles/agents/AGENTS.md" "$dir/CLAUDE.md"
  [[ -e "$dir/settings.json" ]] || ln -s "$HOME/.dotfiles/agents/claude/settings.json" "$dir/settings.json"
}
# <<< claude account switcher <<<


