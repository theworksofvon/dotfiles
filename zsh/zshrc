# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"
export PATH="$HOME/.dotfiles/bin:$HOME/.local/bin:$PATH"

# Tool init snippets (brew shellenv, mise, starship, zoxide, fzf) each cost a
# subprocess spawn — together about 100ms on every shell. Their output only
# changes when the tool itself is upgraded, so cache it to disk and regenerate
# when the binary is newer than the cache.
#
# _init_cache <name> <binary> <command...>
_zsh_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh-init"
[ -d "$_zsh_cache_dir" ] || mkdir -p "$_zsh_cache_dir"

_init_cache() {
  local name=$1 bin=$2
  shift 2
  local resolved cache="$_zsh_cache_dir/$name.zsh"
  resolved=$(command -v "$bin") || return 0
  if [[ ! -s $cache || $resolved -nt $cache ]]; then
    "$@" >| "$cache" 2>/dev/null || { rm -f "$cache"; return 0; }
  fi
  source "$cache"
}

# Homebrew — prefix differs by platform (Apple Silicon / Intel / Linux).
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [ -x "$_brew" ] && _init_cache brew "$_brew" "$_brew" shellenv && break
done
unset _brew

# Node comes from mise (activated below), not nvm.

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Ghostty injects its shell integration automatically, but that injection
# doesn't survive into tmux — re-source it manually there.
if [ -n "${TMUX:-}" ] && [ -n "${GHOSTTY_RESOURCES_DIR:-}" ]; then
  _gi="$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration"
  [ -s "$_gi" ] && source "$_gi"
  unset _gi
fi

# mise — manages CLI tools (prettier, sqlfluff) and the Node runtime.
_init_cache mise mise mise activate zsh

# Starship prompt (replaces the Oh My Zsh ZSH_THEME above).
# Falls back to the oh-my-zsh theme if Starship isn't installed yet.
_init_cache starship starship starship init zsh

# ── history ───────────────────────────────────────
# oh-my-zsh sets HISTSIZE=50000 but SAVEHIST=10000, so 50k commands accumulate
# in memory and only the newest 10k survive the shell exiting. Match them.
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY       # record timestamps
setopt HIST_IGNORE_SPACE      # a leading space keeps a command out of history
setopt HIST_REDUCE_BLANKS     # tidy whitespace before saving
setopt HIST_VERIFY            # expand !! for review instead of running it blind

# Neovim as the editor everywhere — git commit messages, `edit`, sudoedit.
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
  export VISUAL=nvim
  alias vim=nvim
  alias vi=nvim
fi

# ── modern CLI replacements ───────────────────────
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -l --git --group-directories-first'
  alias la='eza -la --git --group-directories-first'
  alias tree='eza --tree'
fi
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'

# zoxide learns the directories you visit: `z partial-name` jumps to the best
# match. `cd` is left alone so muscle memory still works.
_init_cache zoxide zoxide zoxide init zsh

# fzf: Ctrl-R fuzzy history, Ctrl-T file picker, Alt-C directory jump.
if command -v fzf >/dev/null 2>&1; then
  # stderr silenced: fzf's widgets touch zle, which warns in shells that have
  # no line editor (zsh -i -c, scripted sourcing).
  _init_cache fzf fzf fzf --zsh 2>/dev/null
  export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --info=inline"
  command -v fd >/dev/null 2>&1 && export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
fi

# ── zsh plugins ───────────────────────────────────
# Order matters: syntax-highlighting must be sourced last, and
# autosuggestions expects to come before it.
_zsh_plugin_dir="${HOMEBREW_PREFIX:-/opt/homebrew}/share"
[ -s "$_zsh_plugin_dir/zsh-autosuggestions/zsh-autosuggestions.zsh" ] &&
  source "$_zsh_plugin_dir/zsh-autosuggestions/zsh-autosuggestions.zsh"
[ -s "$_zsh_plugin_dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] &&
  source "$_zsh_plugin_dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
unset _zsh_plugin_dir

# AI usage at a glance: `ai-usage` for both, or claude-usage / codex-usage
# alone. Both live in ~/dotfiles/bin (on PATH above).
# Not named `usage` — that's usage-cli, which mise depends on.
ai-usage() {
  claude-usage "$@"
  echo
  codex-usage "$@"
  if command -v opencode >/dev/null 2>&1; then
    echo
    opencode-usage "$@"
  fi
}

# Push notification when a quota crosses 80%. Backgrounded so it never delays
# the prompt, and self-throttled to once per provider per hour.
command -v usage-alert >/dev/null 2>&1 && (usage-alert &) >/dev/null 2>&1

# Switch between prompt presets: `prompt-style bridge` or `prompt-style mission`
# Re-points the symlink rather than copying, so editing ~/.config/starship.toml
# edits the preset in ~/dotfiles directly.
prompt-style() {
  local p="$HOME/.config/starship/$1.toml"
  if [[ -f "$p" ]]; then
    ln -sfn "$p" "$HOME/.config/starship.toml" && echo "✔ Prompt → $1 (press Enter to see it)"
  else
    echo "usage: prompt-style bridge|mission"
  fi
}

