# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Skip Oh My Zsh's fpath security audit. Homebrew here is owned by a different
# local account, so compaudit flags every completion dir and prompts on login.
# The dirs are 0755 (not group/world-writable), so the audit adds no real safety.
export ZSH_DISABLE_COMPFIX=true

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time Oh My Zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="robbyrussell"

# Set list of themes to pick from when loading at random
# Setting this variable when ZSH_THEME=random will cause zsh to load
# a theme from this variable instead of looking in $ZSH/themes/
# If set to an empty array, this variable will have no effect.
# ZSH_THEME_RANDOM_CANDIDATES=( "robbyrussell" "agnoster" )

# Uncomment the following line to use case-sensitive completion.
# CASE_SENSITIVE="true"

# Uncomment the following line to use hyphen-insensitive completion.
# Case-sensitive completion must be off. _ and - will be interchangeable.
# HYPHEN_INSENSITIVE="true"

# Uncomment one of the following lines to change the auto-update behavior
# zstyle ':omz:update' mode disabled  # disable automatic updates
# zstyle ':omz:update' mode auto      # update automatically without asking
# zstyle ':omz:update' mode reminder  # just remind me to update when it's time

# Uncomment the following line to change how often to auto-update (in days).
# zstyle ':omz:update' frequency 13

# Uncomment the following line if pasting URLs and other text is messed up.
# DISABLE_MAGIC_FUNCTIONS="true"

# Uncomment the following line to disable colors in ls.
# DISABLE_LS_COLORS="true"

# Uncomment the following line to disable auto-setting terminal title.
# DISABLE_AUTO_TITLE="true"

# Uncomment the following line to enable command auto-correction.
# ENABLE_CORRECTION="true"

# Uncomment the following line to display red dots whilst waiting for completion.
# You can also set it to another string to have that shown instead of the default red dots.
# e.g. COMPLETION_WAITING_DOTS="%F{yellow}waiting...%f"
# Caution: this setting can cause issues with multiline prompts in zsh < 5.7.1 (see #5765)
# COMPLETION_WAITING_DOTS="true"

# Uncomment the following line if you want to disable marking untracked files
# under VCS as dirty. This makes repository status check for large repositories
# much, much faster.
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# You can set one of the optional three formats:
# "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# or set a custom format using the strftime function format specifications,
# see 'man strftime' for details.
# HIST_STAMPS="mm/dd/yyyy"

# Would you like to use another custom folder than $ZSH/custom?
# ZSH_CUSTOM=/path/to/new-custom-folder

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(git)

# zsh-autosuggestions and zsh-syntax-highlighting come from Homebrew rather
# than $ZSH_CUSTOM, so they're sourced below the oh-my-zsh init instead.

[ -s "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# User configuration

# export MANPATH="/usr/local/man:$MANPATH"

# You may need to manually set your language environment
# export LANG=en_US.UTF-8

# Preferred editor for local and remote sessions
# if [[ -n $SSH_CONNECTION ]]; then
#   export EDITOR='vim'
# else
#   export EDITOR='nvim'
# fi

# Compilation flags
# export ARCHFLAGS="-arch $(uname -m)"

# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"
# PATH for ~/.dotfiles/bin is set after the tool inits below, not here — brew
# shellenv and mise both prepend, so anything exported at this point loses to
# them. bin/gh has to win over the Homebrew gh to do its routing.

# Tool init snippets (brew shellenv, mise, starship, zoxide, fzf) each cost a
# subprocess spawn — together about 100ms on every shell. Their output only
# changes when the tool itself is upgraded, so cache it to disk and regenerate
# when the binary is newer than the cache.
#
# _init_cache <name> <binary> <command...>
_zsh_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh-init"
[ -d "$_zsh_cache_dir" ] || mkdir -p "$_zsh_cache_dir"

_init_cache() {
  local name=$1 bin=$2
  shift 2
  local resolved cache="$_zsh_cache_dir/$name.zsh"
  resolved=$(command -v "$bin") || return 0
  if [[ ! -s $cache || $resolved -nt $cache ]]; then
    "$@" >| "$cache" 2>/dev/null || { rm -f "$cache"; return 0; }
  fi
  source "$cache"
}

# Homebrew — prefix differs by platform (Apple Silicon / Intel / Linux).
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [ -x "$_brew" ] && _init_cache brew "$_brew" "$_brew" shellenv && break
done
unset _brew

# Node comes from mise (activated below), not nvm.

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# mise — manages CLI tools (prettier, sqlfluff, cswap) and the Node runtime.
_init_cache mise mise mise activate zsh

# Last of the PATH prepends, so the shims here outrank the tools they wrap —
# bin/gh has to shadow the Homebrew gh. Nothing else in bin/ collides with a
# brew or mise binary, so winning outright costs nothing.
export PATH="$HOME/.dotfiles/bin:$HOME/.local/bin:$PATH"

# Starship prompt (replaces the Oh My Zsh ZSH_THEME above).
# Falls back to the oh-my-zsh theme if Starship isn't installed yet.
_init_cache starship starship starship init zsh

# ── history ───────────────────────────────────────
# oh-my-zsh sets HISTSIZE=50000 but SAVEHIST=10000, so 50k commands accumulate
# in memory and only the newest 10k survive the shell exiting. Match them.
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY       # record timestamps
setopt HIST_IGNORE_SPACE      # a leading space keeps a command out of history
setopt HIST_REDUCE_BLANKS     # tidy whitespace before saving
setopt HIST_VERIFY            # expand !! for review instead of running it blind

# Neovim as the editor everywhere — git commit messages, `edit`, sudoedit.
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
  export VISUAL=nvim
  alias vim=nvim
  alias vi=nvim
fi

# ── modern CLI replacements ───────────────────────
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -l --git --group-directories-first'
  alias la='eza -la --git --group-directories-first'
  alias tree='eza --tree'
fi
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'

# zoxide learns the directories you visit: `z partial-name` jumps to the best
# match. `cd` is left alone so muscle memory still works.
_init_cache zoxide zoxide zoxide init zsh

# fzf: Ctrl-R fuzzy history, Ctrl-T file picker, Alt-C directory jump.
if command -v fzf >/dev/null 2>&1; then
  # stderr silenced: fzf's widgets touch zle, which warns in shells that have
  # no line editor (zsh -i -c, scripted sourcing).
  _init_cache fzf fzf fzf --zsh 2>/dev/null
  export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --info=inline"
  command -v fd >/dev/null 2>&1 && export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
fi

# ── zsh plugins ───────────────────────────────────
# Order matters: syntax-highlighting must be sourced last, and
# autosuggestions expects to come before it.
_zsh_plugin_dir="${HOMEBREW_PREFIX:-/opt/homebrew}/share"
[ -s "$_zsh_plugin_dir/zsh-autosuggestions/zsh-autosuggestions.zsh" ] &&
  source "$_zsh_plugin_dir/zsh-autosuggestions/zsh-autosuggestions.zsh"
[ -s "$_zsh_plugin_dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] &&
  source "$_zsh_plugin_dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
unset _zsh_plugin_dir

# AI usage at a glance: `ai-usage` for both, or claude-usage / codex-usage
# alone. Both live in ~/dotfiles/bin (on PATH above).
# Not named `usage` — that's usage-cli, which mise depends on.
ai-usage() {
  claude-usage "$@"
  echo
  codex-usage "$@"
  if command -v opencode >/dev/null 2>&1; then
    echo
    opencode-usage "$@"
  fi
}

# Push notification when a quota crosses 80%. Backgrounded so it never delays
# the prompt, and self-throttled to once per provider per hour.
command -v usage-alert >/dev/null 2>&1 && (usage-alert &) >/dev/null 2>&1

# Switch between prompt presets: `prompt-style bridge` or `prompt-style mission`
# Re-points the symlink rather than copying, so editing ~/.config/starship.toml
# edits the preset in ~/dotfiles directly.
prompt-style() {
  local p="$HOME/.config/starship/$1.toml"
  if [[ -f "$p" ]]; then
    ln -sfn "$p" "$HOME/.config/starship.toml" && echo "✔ Prompt → $1 (press Enter to see it)"
  else
    echo "usage: prompt-style bridge|mission"
  fi
}

# gh routing lives in ~/.dotfiles/bin/gh, not a function here — a function only
# applies inside interactive zsh, so scripts and other processes bypassed it.

# Claude account by directory, the same rule git and gh follow: work under
# ~/costmine, personal everywhere else. cswap gives each account its own
# CLAUDE_CONFIG_DIR — which Claude hashes into its Keychain service name — so
# they stay isolated and can run side by side without swapping any shared login.
#
# Not a `claude` wrapper: Claude Code re-execs itself for subagents and hooks,
# and putting a launcher in that path would route them through cswap too.
#   cc            → the account mapped to this directory
#   cc 2          → a specific account, this terminal only
#   cswap map     → show the directory mappings
#   cswap list    → accounts with live usage
cc() { cswap run "$@" }

# Course work runs on a clean slate: an empty CLAUDE_CONFIG_DIR means no global
# CLAUDE.md, no skills, plugins or hooks, so course material can't interact with
# this setup — and nothing here has to be backed up or moved aside to get there.
#
# Scoped by directory rather than a launcher for the reason cc isn't one either:
# plain `claude` inherits the exported var, including the subagent and hook
# re-execs an alias would miss. Only unsets what it set, so cc stays untouched.
CLAUDE_COURSE_DIR="$HOME/dev/ai-hero"
CLAUDE_COURSE_CONFIG="$HOME/.claude-course"
autoload -Uz add-zsh-hook
claude-course-config() {
  if [[ "$PWD/" == "$CLAUDE_COURSE_DIR"/* ]]; then
    export CLAUDE_CONFIG_DIR="$CLAUDE_COURSE_CONFIG"
  elif [[ "$CLAUDE_CONFIG_DIR" == "$CLAUDE_COURSE_CONFIG" ]]; then
    unset CLAUDE_CONFIG_DIR
  fi
}
add-zsh-hook chpwd claude-course-config
claude-course-config

# opencode
export PATH="$HOME/.opencode/bin:$PATH"
