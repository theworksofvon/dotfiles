#!/usr/bin/env node
/**
 * guard — the one pre-tool hook every harness runs.
 *
 * Claude Code, Codex, and opencode each have their own hook config, and a
 * guard listed in one is easy to forget in the others. So each config points
 * here and nowhere else, and this file decides which guards a tool call gets.
 * Adding a guard is one edit to ROUTES.
 *
 * Reads the Claude-shaped hook payload on stdin ({tool_name, tool_input, cwd})
 * and forwards it unchanged to each guard that applies. The first guard to
 * exit 2 wins: its message goes to stderr and this exits 2 so the harness
 * blocks the call and shows the model why.
 *
 *   echo '{"tool_name":"Bash","tool_input":{"command":"git push origin main"}}' | guard
 */

import { spawnSync } from "node:child_process";
import { readFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const HOOKS = dirname(fileURLToPath(import.meta.url));

// Shell tools under every name the three harnesses use for them.
const SHELL = /^(Bash|bash|shell|local_shell|exec_command)$/;
const GITHUB_MCP = /github/i;

const ROUTES = [
  [SHELL, ["guard-main", "guard-shell-bomb", "guard-org-writes"]],
  [GITHUB_MCP, ["guard-org-writes"]],
];

let raw = "";
try {
  raw = readFileSync(0, "utf8");
} catch {
  process.exit(0);
}

let tool = "";
try {
  tool = JSON.parse(raw).tool_name ?? "";
} catch {
  process.exit(0); // unparseable payload is not grounds to block
}

const route = ROUTES.find(([pattern]) => pattern.test(tool));
if (!route) process.exit(0);

for (const name of route[1]) {
  const result = spawnSync(join(HOOKS, name), [], {
    input: raw,
    encoding: "utf8",
  });
  if (result.status === 2) {
    process.stderr.write(result.stderr);
    process.exit(2);
  }
}
process.exit(0);
