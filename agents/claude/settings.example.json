{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.dotfiles/agents/hooks/agent-notify\"",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.dotfiles/agents/hooks/format-on-write\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*[Gg]ithub.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.dotfiles/agents/hooks/guard\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.dotfiles/agents/hooks/agent-notify\"",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "outputStyle": "Simple",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh repo view:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(bat:*)",
      "Bash(eza:*)",
      "Bash(jq:*)",
      "Bash(tree:*)",
      "Bash(just --list)",
      "Bash(mise ls:*)",
      "Bash(mise current:*)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Bash(brew outdated:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(uv run:*)",
      "Bash(ruff:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:mise.jdx.dev)"
    ],
    "ask": [
      "Edit(../**)",
      "Write(../**)",
      "MultiEdit(../**)",
      "Edit(~/.zshrc)",
      "Edit(~/.gitconfig)",
      "Edit(~/.claude/**)",
      "Edit(~/.codex/**)",
      "Edit(~/.config/**)",
      "Write(~/.config/**)",
      "Bash(sudo:*)",
      "Bash(brew uninstall:*)",
      "Bash(brew remove:*)",
      "Bash(brew rm:*)",
      "Bash(brew cleanup:*)",
      "Bash(brew bundle cleanup:*)",
      "Bash(mas uninstall:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm rm:*)",
      "Bash(npm prune:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm uninstall:*)",
      "Bash(pnpm prune:*)",
      "Bash(yarn remove:*)",
      "Bash(bun remove:*)",
      "Bash(pip uninstall:*)",
      "Bash(pip3 uninstall:*)",
      "Bash(uv pip uninstall:*)",
      "Bash(uv tool uninstall:*)",
      "Bash(pipx uninstall:*)",
      "Bash(cargo uninstall:*)",
      "Bash(gem uninstall:*)",
      "Bash(go clean:*)",
      "Bash(mise uninstall:*)",
      "Bash(mise rm:*)",
      "Bash(mise prune:*)",
      "Bash(mise implode:*)",
      "Bash(codex uninstall:*)",
      "Bash(claude uninstall:*)",
      "Bash(opencode uninstall:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker rmi:*)",
      "Bash(docker image prune:*)",
      "Bash(security delete-generic-password:*)",
      "Bash(defaults delete:*)",
      "Bash(rm -rf /Applications:*)",
      "Bash(trash:*)",
      "Bash(gh repo delete:*)",
      "Bash(terraform destroy:*)",
      "Bash(kubectl delete:*)",
      "Bash(dropdb:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin/main:*)",
      "Bash(git filter-branch:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.aws/credentials)",
      "Read(**/.ssh/id_*)",
      "Read(**/*.pem)",
      "Read(**/hosts.yml)",
      "Bash(mv /*)",
      "Bash(rm -rf /opt/homebrew*)",
      "Read(**/*.pfx)",
      "Read(~/.gnupg/**)",
      "Read(**/id_ed25519)"
    ],
    "defaultMode": "acceptEdits"
  },
  "statusLine": {
    "command": "ccstatusline",
    "padding": 0,
    "type": "command"
  },
  "theme": "auto",
  "env": {
    "EDITOR": "nvim"
  },
  "includeCoAuthoredBy": false,
  "alwaysThinkingEnabled": true,
  "fileCheckpointingEnabled": true,
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true
}
