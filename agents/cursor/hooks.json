{
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "$HOME/.dotfiles/bin/guard-main",
        "failClosed": true,
        "matcher": "\\bgit\\s+(push|merge)\\b|\\bgh\\s+pr\\s+merge\\b",
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "command": "bash '/Users/davontaejackson/.cursor/herdr-agent-state.sh' session"
      }
    ]
  },
  "version": 1
}