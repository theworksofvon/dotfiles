#!/usr/bin/env node
/**
 * guard-org-writes — block agent-initiated admin writes on protected GitHub
 * orgs.
 *
 * A permission rule can't catch this. The org name is an argument, not a
 * command prefix, so a static matcher either misses `gh api -X POST
 * repos/Org/...` or has to prompt on every gh call. This runs as a PreToolUse
 * hook, so it can read the resolved command and MCP tool input first.
 *
 * Day-to-day work — pushing feature branches, opening and editing PRs and
 * issues — is allowed; guard-main separately blocks anything landing on a
 * protected branch. What stays gated here is the org-level surface: repo
 * lifecycle, secrets and settings, and raw API writes.
 *
 * Reads the hook payload as JSON on stdin; exits 2 to block. Reads are always
 * allowed — only writes are gated.
 *
 *   echo '{"tool_input":{"command":"gh repo create Org/x"}}' | guard-org-writes
 *   guard-org-writes --test 'gh api -X POST repos/GlacierRIG/x'
 */

import { readFileSync } from "fs";

const PROTECTED_ORGS = ["GlacierRIG"];
const PROTECTED_BRANCHES = /^(main|master|trunk|release)$/i;

const argv = process.argv.slice(2);

function mentionsProtectedOrg(text) {
  return PROTECTED_ORGS.find((org) =>
    new RegExp(`\\b${org}\\b`, "i").test(text),
  );
}

/**
 * Admin-level shell operations. Deliberately narrow: `gh repo clone`, `gh repo
 * view`, and plain `git fetch` all mention the org and must stay allowed —
 * as are `git push`, `gh pr`, and `gh issue`, which guard-main gates when
 * they'd land on a protected branch.
 */
function shellWrite(command) {
  const patterns = [
    [/\bgh\s+repo\s+(create|delete|rename|transfer|archive|edit)\b/i, "changes a repository"],
    [/\bgh\s+api\s+[^|;&]*(-X|--method)\s+(POST|PATCH|PUT|DELETE)\b/i, "sends a write request to the API"],
    [/\bgh\s+(secret|variable|release|workflow|ruleset|label)\s+(set|create|delete|edit|run)\b/i, "changes org or repo settings"],
  ];
  for (const [pattern, reason] of patterns) {
    if (pattern.test(command)) return reason;
  }
  return null;
}

/**
 * MCP GitHub tools. Repo lifecycle and merges are always gated — a merge
 * lands on the base branch, which is usually trunk. Branch-scoped writes
 * (push_files, create_or_update_file, …) are fine on feature branches; only
 * a protected target is blocked, since guard-main can't see MCP calls.
 */
function mcpWrite(toolName, toolInput) {
  if (!/github/i.test(toolName)) return null;
  if (
    !/(create|update|delete|push|merge|write|add|fork|submit|transfer|rename)/i.test(
      toolName,
    )
  ) {
    return null;
  }
  if (/repo/i.test(toolName)) return "changes a repository";
  if (/merge/i.test(toolName)) return "merges into the base branch";
  const branch = toolInput?.branch;
  if (
    typeof branch === "string" &&
    PROTECTED_BRANCHES.test(branch.replace(/^refs\/heads\//, ""))
  ) {
    return `writes to ${branch}`;
  }
  return null;
}

// ── entry ─────────────────────────────────────────

let command = "";
let toolName = "";
let toolInput = {};
let haystack = "";

const testIdx = argv.indexOf("--test");
if (testIdx >= 0) {
  command = argv[testIdx + 1] || "";
  haystack = command;
} else {
  try {
    const payload = JSON.parse(readFileSync(0, "utf8"));
    toolName = payload.tool_name ?? "";
    toolInput = payload.tool_input ?? {};
    command =
      toolInput.command ??
      toolInput.cmd ??
      payload.input?.command ??
      payload.command ??
      "";
    if (Array.isArray(command)) command = command.join(" ");
    // MCP calls carry the org in structured fields, not a command string.
    haystack = command || JSON.stringify(toolInput);
  } catch {
    process.exit(0); // unparseable payload is not grounds to block
  }
}

if (!haystack) process.exit(0);

const org = mentionsProtectedOrg(haystack);
if (!org) process.exit(0);

const reason = command ? shellWrite(command) : mcpWrite(toolName, toolInput);
if (!reason) process.exit(0);

// Exit 2 is the blocking convention: the message goes back to the model so it
// explains itself rather than silently retrying.
process.stderr.write(
  `Blocked: this command ${reason} on the ${org} org. Creating or changing ` +
    `anything under ${org} needs explicit approval from the user first. Ask ` +
    `them to confirm, or to run it themselves.\n`,
);
process.exit(2);
