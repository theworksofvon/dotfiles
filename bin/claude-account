#!/usr/bin/env node
/**
 * claude-account — which Claude account is currently active.
 *
 * Useful when juggling logins (see the claude-account-* helpers in zshrc):
 * the org name Anthropic returns is long and unhelpful, so map org IDs — or
 * account names — to short labels in ~/.config/claude-account/accounts.json:
 *
 *   { "<org-uuid>": { "label": "personal", "color": "cyan" } }
 *   { "cm":        { "label": "costmine", "color": "magenta" } }
 *
 * claude-account-run exports CLAUDE_ACCOUNT_LABEL, which wins outright: token
 * auth reports no org or email, so a launched account can only be identified
 * by the name it was launched under. Otherwise the org mapping is used, then
 * the email prefix. Cached 60s since it's rendered in the status line.
 */

import { execFileSync } from "child_process";
import { createHash } from "crypto";
import { mkdirSync, readFileSync, writeFileSync } from "fs";
import { homedir } from "os";
import { join } from "path";

const CONFIG = join(homedir(), ".config", "claude-account", "accounts.json");
const CACHE_DIR = join(homedir(), ".cache", "claude-account");
// Accounts run concurrently in separate terminals, each with its own
// CLAUDE_CONFIG_DIR, so a single cache file would leak one session's label
// into the other's status line for up to a TTL.
const CACHE = join(
  CACHE_DIR,
  `status-${createHash("sha256").update(process.env.CLAUDE_CONFIG_DIR || "default").digest("hex").slice(0, 12)}.json`,
);
const TTL_MS = 60 * 1000;

const COLORS = {
  black: 30, red: 31, green: 32, yellow: 33,
  blue: 34, magenta: 35, cyan: 36, white: 37,
};

function cached() {
  try {
    const c = JSON.parse(readFileSync(CACHE, "utf8"));
    if (Date.now() - c.timestamp < TTL_MS) return c.status;
  } catch {
    /* no cache */
  }
  return null;
}

function store(status) {
  try {
    mkdirSync(CACHE_DIR, { recursive: true });
    writeFileSync(CACHE, JSON.stringify({ timestamp: Date.now(), status }));
  } catch {
    /* cache is optional */
  }
}

function authStatus() {
  try {
    // Clearing ANTHROPIC_API_KEY forces the OAuth identity to be reported
    // rather than whatever an env-var key would resolve to.
    const env = { ...process.env };
    delete env.ANTHROPIC_API_KEY;
    const raw = execFileSync("claude", ["auth", "status"], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
      env,
    });
    return JSON.parse(raw);
  } catch {
    return null;
  }
}

let accounts = {};
try {
  accounts = JSON.parse(readFileSync(CONFIG, "utf8"));
} catch {
  /* unmapped is fine */
}

// A launched account knows its own name, so skip the auth call entirely.
const named = process.env.CLAUDE_ACCOUNT_LABEL;
if (named) {
  const entry = accounts[named];
  const code = COLORS[entry?.color] ?? COLORS.cyan;
  process.stdout.write(`\x1b[${code}m${entry?.label || named}\x1b[0m`);
  process.exit(0);
}

let status = cached();
if (!status) {
  status = authStatus();
  if (status) store(status);
}

if (!status?.loggedIn) process.exit(0);

const entry = accounts[status.orgId];
const label = entry?.label || (status.email || "").split("@")[0] || "claude";
const code = COLORS[entry?.color] ?? COLORS.cyan;

process.stdout.write(`\x1b[${code}m${label}\x1b[0m`);
