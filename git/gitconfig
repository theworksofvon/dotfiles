# Identity lives in an untracked local file so forks don't commit as me.
# setup.sh creates it; see git/gitconfig.local.example.
[include]
	path = ~/.gitconfig.local

# Work repos live under ~/costmine and belong to a second GitHub account, so
# they need their own identity and SSH key. Listed after the include above so
# these values win inside that tree; everywhere else the personal ones stand.
# The trailing slash matters — it matches the directory's contents.
[includeIf "gitdir:~/costmine/"]
	path = ~/.gitconfig.work

[init]
	defaultBranch = main

[core]
	autocrlf = input
	editor = nvim
	whitespace = trailing-space,space-before-tab
	excludesfile = ~/.gitignore_global
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true

# ── diff / merge quality ──────────────────────────
[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
	renames = true

[merge]
	conflictstyle = zdiff3

# Reuse recorded conflict resolutions, so a conflict resolved once
# is replayed automatically the next time it appears.
[rerere]
	enabled = true
	autoupdate = true

# ── workflow ──────────────────────────────────────
[fetch]
	prune = true
	pruneTags = true

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	followTags = true

[rebase]
	autosquash = true
	autoStash = true
	updateRefs = true

[commit]
	verbose = true

[help]
	autocorrect = prompt

# ── ui ────────────────────────────────────────────
[column]
	ui = auto

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[credential "https://github.com"]
	helper = !gh auth git-credential

[alias]
	st = status --short --branch
	last = log -1 --stat
	unstage = restore --staged

# required = true makes every git command fail if git-lfs is missing, so it's
# pinned in the Brewfile.
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
